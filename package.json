{
  "name": "send-approve-bound",
  "version": "0.1.0",
  "description": "Non-custodial at-send gate: bound approve/increaseAllowance/setApprovalForAll (per-token spender allowlist + erc20 raw caps; unlimited always denied). Compose after send-allow. No keys, no sim.",
  "type": "module",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "bin": {
    "send-approve-bound": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "policy.example.json",
    "policy.agent.example.json",
    "docs/fixtures/offline.expected.txt",
    "SECURITY.md",
    "CHARTER.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "demo:offline": "npm run build && node scripts/demo-offline.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ethereum",
    "approve",
    "allowance",
    "middleware",
    "agent",
    "fail-closed"
  ],
  "license": "MIT",
  "author": {
    "name": "yellowgram",
    "url": "https://www.yellowgram.dev"
  },
  "private": true,
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellowgram/send-approve-bound.git"
  },
  "bugs": {
    "url": "https://github.com/yellowgram/send-approve-bound/issues"
  },
  "homepage": "https://www.yellowgram.dev/oss"
}
